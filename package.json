{
  "name": "unuvia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4200",
    "start": "next start --hostname 127.0.0.1 --port 4200",
    "build": "next build",
    "check": "tsc --noEmit",
    "auth:check": "node scripts/auth-check.mjs",
    "claude:check": "node scripts/claude-check.mjs",
    "prod:check": "node scripts/prod-check.mjs",
    "deploy:pack": "next build && tar -czf unuvia-deploy.tar.gz --exclude=.next/cache --exclude=.next/dev --exclude=.next/trace --exclude=.next/trace-build .next public scripts/prod-check.mjs app.js package.json package-lock.json next.config.ts",
    "test:api": "node --experimental-vm-modules --test tests/*-api.test.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs README.md"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/fra": "^1.0.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.16",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.4",
    "typescript": "~5.9.3"
  }
}
