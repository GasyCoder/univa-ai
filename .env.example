# Use a random secret of at least 32 characters. Never commit .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4200
# Persistent filesystem path; this application uses the Node.js runtime.
AUTH_DATABASE_PATH=.data/univa.sqlite
# Google Cloud OAuth web application credentials:
# Redirect URI: http://127.0.0.1:4200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
