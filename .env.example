# Use a random secret of at least 32 characters. Never commit .env.local.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4200
# PostgreSQL connection string, server-side only.
DATABASE_URL=postgresql://unuvia:password@127.0.0.1:5432/unuvia
# Google Cloud OAuth web application credentials (sign-in and the Google Drive connector).
# For Drive: enable the "Google Drive API" and add the scope drive.readonly to the consent screen.
# Redirect URI: http://127.0.0.1:4200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# APMIX server-side key from Dashboard > API keys. Never use NEXT_PUBLIC_*.
APMIX_API_KEY=

# Only verified accounts listed here can administer subscriptions.
ADMIN_EMAILS=
# Instructions for payments made outside the app. Empty = payment method unavailable.
PAYMENT_MOBILE_MONEY_INSTRUCTIONS=
PAYMENT_CARD_INSTRUCTIONS=
# Confirm the Madagascar price (whole ariary) before setting this value.
PRO_PRICE_MGA=
